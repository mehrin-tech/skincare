<!-- Interactive CSS/JS Category Tabs & Carousel Scripts -->
<script>
  function switchTab(tabId) {
    // Hide all service panes
    const panes = document.querySelectorAll('.services-tab-pane');
    panes.forEach(pane => pane.classList.add('hidden'));

    // Remove active styles from all buttons
    const buttons = document.querySelectorAll('.tab-btn');
    buttons.forEach(btn => btn.classList.remove('active'));

    // Show selected pane
    const selectedPane = document.getElementById(tabId);
    if (selectedPane) {
      selectedPane.classList.remove('hidden');
    }

    // Set button active
    const selectedBtn = document.getElementById(tabId + '-btn');
    if (selectedBtn) {
      selectedBtn.classList.add('active');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.getElementById('testimonial-slider');
    const prev = document.getElementById('slider-prev');
    const next = document.getElementById('slider-next');

    if (slider && prev && next) {
      const getScrollAmount = () => {
        const card = slider.querySelector('.slider-card');
        return card ? card.offsetWidth + 32 : 300; 
      };

      prev.addEventListener('click', () => {
        slider.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });
      });

      next.addEventListener('click', () => {
        slider.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });
      });
    }
  });
</script>

