<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Main Layout Wrapper with Multispecialty Brand Aesthetic -->
<main class="flex-grow w-full relative overflow-hidden bg-[#FCFBF9] min-h-screen">
    
    <!-- Organic Background Decorative Blobs (Ambient Glows) -->
    <div class="absolute top-[8%] left-[-15%] w-[450px] h-[450px] rounded-full blob-organic blob-teal z-0 pointer-events-none"></div>
    <div class="absolute top-[30%] right-[-15%] w-[550px] h-[550px] rounded-full blob-organic blob-mint z-0 pointer-events-none"></div>
    <div class="absolute bottom-[18%] left-[5%] w-[500px] h-[500px] rounded-full blob-organic blob-beige z-0 pointer-events-none"></div>

    <!-- 1. Hero Section -->
    <section class="relative pt-12 pb-24 md:pt-20 md:pb-32 z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-16">
            
            <!-- Left Column: High-End Copy -->
            <div class="w-full lg:w-1/2 flex flex-col text-left">
                <!-- Glowing Trusted Badge -->
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#E0F4F3] border border-[#B3EAE6] text-[#0C8F89] w-fit mb-8 shadow-sm pulse-badge">
                    <svg class="w-4 h-4 text-[#0FA7A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    <span class="text-xs font-bold uppercase tracking-widest">TRUSTED CLINIC EXPERTS</span>
                </div>

                <!-- Editorial Headline -->
                <h1 class="font-luxury-heading text-4xl sm:text-5xl lg:text-6xl font-semibold text-[#1D2B4F] leading-[1.1] mb-6">
                    Reveal Your <br/>
                    <span class="font-light italic text-[#0FA7A0] relative">
                        Natural Beauty & Smile
                        <span class="absolute bottom-1 left-0 w-full h-[6px] bg-[#E0F4F3]/70 -z-10 rounded-full"></span>
                    </span>
                </h1>

                <!-- Subheadline -->
                <p class="text-slate-500 font-light text-base sm:text-lg leading-relaxed max-w-xl mb-10">
                    Advanced skin, hair, and dental treatments designed to restore, enhance, and protect your confidence, wellness, and long-lasting care.
                </p>

                <!-- Action Button Cluster -->
                <div class="flex flex-col sm:flex-row items-center gap-4 mb-10">
                    <a href="/book-appointment" class="w-full sm:w-auto px-8 py-4 rounded-full text-center text-sm font-bold uppercase tracking-wider text-white btn-luxury-gradient shadow-lg">
                        Book Consultation
                    </a>
                    <a href="/services" class="w-full sm:w-auto px-8 py-4 rounded-full text-center text-sm font-bold uppercase tracking-wider btn-luxury-outline">
                        Explore Services
                    </a>
                </div>

                <!-- Client Rating Badge -->
                <div class="flex items-center gap-4 border-t border-[#FAF6F0] pt-6 w-fit">
                    <div class="flex -space-x-2.5 overflow-hidden">
                        <img class="inline-block h-9 w-9 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100" alt="Client 1">
                        <img class="inline-block h-9 w-9 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&q=80&w=100" alt="Client 2">
                        <img class="inline-block h-9 w-9 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=100" alt="Client 3">
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-bold text-[#1D2B4F]">5000+ Happy Clients</span>
                            <span class="text-xs text-amber-500">★★★★★</span>
                        </div>
                        <p class="text-xs text-slate-400 font-light">Rated 5 Stars by verified patients</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Stunning Center Image & 4 Floating Glass Cards -->
            <div class="w-full lg:w-1/2 relative flex justify-center mt-12 lg:mt-0">
                
                <!-- Centerpiece Model Image with Aesthetic Border -->
                <div class="relative z-10 w-full max-w-[420px] aspect-[4/5] overflow-hidden rounded-[3rem] shadow-2xl border-[10px] border-white/80 transform hover:scale-[1.01] transition-transform duration-500 bg-white">
                    <img src="/images/glow_skin_hero.png" alt="Confident Smiling Model" class="w-full h-full object-cover">
                </div>

                <!-- Floating Glassmorphic Card 1: Skin Specialists -->
                <div class="absolute top-[8%] -left-6 sm:-left-12 z-20 glass-card p-4 rounded-2xl flex items-center gap-3 animate-float max-w-[210px]">
                    <div class="w-9 h-9 rounded-xl bg-teal-50 text-[#0FA7A0] flex items-center justify-center font-bold text-lg">✨</div>
                    <div>
                        <h4 class="text-xs font-bold text-[#1D2B4F] leading-none">Skin Care</h4>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Dermal Specialists</p>
                    </div>
                </div>

                <!-- Floating Glassmorphic Card 2: Hair Experts -->
                <div class="absolute top-[35%] -right-8 z-20 glass-card p-4 rounded-2xl flex items-center gap-3 animate-float-delayed max-w-[210px]">
                    <div class="w-9 h-9 rounded-xl bg-[#E0F4F3] text-[#0FA7A0] flex items-center justify-center font-bold">💇‍♀️</div>
                    <div>
                        <h4 class="text-xs font-bold text-[#1D2B4F] leading-none">Hair Care</h4>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">PRP & Scalp Experts</p>
                    </div>
                </div>

                <!-- Floating Glassmorphic Card 3: Dental Care -->
                <div class="absolute bottom-[20%] -left-8 z-20 glass-card p-4 rounded-2xl flex items-center gap-3 animate-float-slow max-w-[210px]">
                    <div class="w-9 h-9 rounded-xl bg-teal-50 text-[#0FA7A0] flex items-center justify-center font-bold">🦷</div>
                    <div>
                        <h4 class="text-xs font-bold text-[#1D2B4F] leading-none">Dental Care</h4>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">Cosmetic Dentistry</p>
                    </div>
                </div>

                <!-- Floating Glassmorphic Card 4: Advanced Technology -->
                <div class="absolute bottom-[6%] -right-4 z-20 glass-card p-4 rounded-2xl flex items-center gap-3 animate-float-extra max-w-[220px]">
                    <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">⚙️</div>
                    <div>
                        <h4 class="text-xs font-bold text-[#1D2B4F] leading-none">Advanced Tech</h4>
                        <p class="text-[10px] text-slate-500 font-medium mt-1">FDA Approved Lasers</p>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- 2. Interactive Services Section -->
    <section id="treatments" class="relative py-24 bg-white z-10 border-y border-[#FAF6F0]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-xs font-bold uppercase tracking-widest text-[#0FA7A0] mb-4 inline-block">CLINICAL SUITES</span>
                <h2 class="font-luxury-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#1D2B4F] leading-tight">
                    Complete Care for <br/>
                    <span class="font-light italic text-[#0FA7A0]">Your Beauty & Health</span>
                </h2>
                <p class="text-slate-500 font-light text-sm sm:text-base mt-4 leading-relaxed">
                    Explore our three luxury clinical categories engineered with board-certified diagnostics and gold-standard technology.
                </p>
            </div>

            <!-- Custom Interactive Categories Switcher (Tabs) -->
            <div class="flex justify-center gap-3 mb-16 max-w-lg mx-auto p-1 bg-slate-100 rounded-full border border-slate-200">
                <button onclick="switchTab('skin-care-tab')" id="skin-care-tab-btn" class="tab-btn active flex-1 py-3 px-6 rounded-full text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-[#0FA7A0] text-center">
                    Skin Care
                </button>
                <button onclick="switchTab('hair-care-tab')" id="hair-care-tab-btn" class="tab-btn flex-1 py-3 px-6 rounded-full text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-[#0FA7A0] text-center">
                    Hair Care
                </button>
                <button onclick="switchTab('dental-care-tab')" id="dental-care-tab-btn" class="tab-btn flex-1 py-3 px-6 rounded-full text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-[#0FA7A0] text-center">
                    Dental Care
                </button>
            </div>

            <!-- Tab Contents (12 Premium Cards Total, 4 per Tab) -->
            <div>
                
                <!-- Category 1: SKIN CARE -->
                <div id="skin-care-tab" class="services-tab-pane grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    
                    <!-- Skin Card 1: Acne Treatment -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="/images/acne_treatment.png" alt="Acne Treatment" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Acne Treatment
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Target lesions, reduce scars, and clarify clogged sebaceous glands combining phototherapy and extractions.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Skin Card 2: Hydra Facial -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="/images/hydrafacial.png" alt="Hydra Facial" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Hydra Facial
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Multi-stage deep extraction facial using intense custom vacuum suction and hydro-antioxidant serums.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Skin Card 3: Anti Aging -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="/images/anti_aging.png" alt="Anti Aging" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Anti Aging
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Smooth micro-wrinkles, restore lost facial volume, and lift skin margins with clinically sound peptides.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Skin Card 4: Pigmentation Care -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="/images/chemical_peel.png" alt="Pigmentation Care" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Pigmentation Care
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Eradicate melasma, age spots, and hyperpigmentation with chemical peels and focused diagnostic scaling.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Category 2: HAIR CARE (Hidden by default) -->
                <div id="hair-care-tab" class="services-tab-pane hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    
                    <!-- Hair Card 1: Hair Fall Treatment -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative bg-slate-100">
                            <img src="/images/hair_care.png" alt="Hair Fall Treatment" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Hair Fall Treatment
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Stop severe hair loss and strengthen delicate roots with specialized diagnostic checks and nutrition.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Hair Card 2: PRP Therapy -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="/images/laser_therapy.png" alt="PRP Therapy" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> PRP Therapy
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Platelet-rich plasma cell injections designed to awaken sleeping follicles and increase strand density.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Hair Card 3: Hair Restoration -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative bg-slate-100">
                            <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&q=80&w=400" alt="Hair Restoration" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Hair Restoration
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Reconstruct thinning crown layouts using precision follicular transfer technologies and micro-grafts.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Hair Card 4: Scalp Care -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="https://images.unsplash.com/photo-1596178065887-1198b6148b2b?auto=format&fit=crop&q=80&w=400" alt="Scalp Care" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Scalp Care
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Treat scales, dandruff, and follicular toxicity using clinical exfoliation and customized tea tree steams.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Category 3: DENTAL CARE (Hidden by default) -->
                <div id="dental-care-tab" class="services-tab-pane hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    
                    <!-- Dental Card 1: Teeth Whitening -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&q=80&w=400" alt="Teeth Whitening" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-[#1D2B4F] mb-2 flex items-center gap-2">
                                    <span class="text-[#0FA7A0]">✦</span> Teeth Whitening
                                </h3>
                                <p class="text-slate-500 font-light text-xs leading-relaxed mb-6">
                                    Achieve up to 8 shades lighter with clinical cold-laser activation systems and custom home kits.
                                </p>
                            </div>
                            <a href="/services" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-[#0C8F89] hover:text-[#0FA7A0] transition-colors gap-1 group/link">
                                Learn More <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </div>

                    <!-- Dental Card 2: Smile Designing -->
                    <div class="glass-card glass-card-hover rounded-[2rem] overflow-hidden flex flex-col p-5 group">
                        <div class="w-full h-48 rounded-[1.5rem] overflow-hidden mb-5 relative">
                            <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&q=80&w=400" alt="Smile Designing" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
                        </div>
                        <div class="px-2 flex-grow flex flex-col justify-between">
