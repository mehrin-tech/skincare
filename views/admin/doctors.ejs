                    <tbody class="divide-y divide-gray-100 text-sm">

<% doctors.forEach(d => { %>

<tr class="hover:bg-slate-50">

    <td class="px-4 py-4 font-medium">
        Dr. <%= d.name %>
    </td>

    <td class="px-4 py-4">
        <%= d.email %>
    </td>

    <td class="px-4 py-4">
        <%= d.phone %>
    </td>

    <td class="px-4 py-4">
        <%= d.department %>
    </td>

    <td class="px-4 py-4">
        <%= d.qualification %>
    </td>

    <td class="px-4 py-4">
        <%= d.experience %>
    </td>

    <td class="px-4 py-4">
        ₹ <%= d.fee %>
    </td>

    <td class="px-4 py-4">
        <%= d.availableDays %><br>
        <span class="text-xs text-gray-500">
            <%= d.availableTime %>
        </span>
    </td>

    <td class="px-4 py-4 text-center">

        <% if(d.status==="verified"){ %>

        <span class="px-3 py-1 rounded-full text-xs bg-green-100 text-green-700">
            Verified
        </span>

        <% }else{ %>

        <span class="px-3 py-1 rounded-full text-xs bg-yellow-100 text-yellow-700">
            Pending
        </span>

        <% } %>

    </td>

    <td class="px-4 py-4">

        <div class="flex gap-2 justify-center">

            <!-- <form action="/admin/doctors/status/<%= d._id %>" method="POST">

                <input
                    type="hidden"
